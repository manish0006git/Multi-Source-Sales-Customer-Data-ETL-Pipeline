# Copy this file to .env and fill in real values. Never commit .env itself.

# Source database (used by db_extractor.py)
SOURCE_DB_URI=sqlite:///data/raw/source.db

# Target warehouse database (used by warehouse_loader.py)
WAREHOUSE_DB_URI=sqlite:///data/processed/warehouse.db

# Public API used by api_extractor.py (example: exchangerate.host)
API_BASE_URL=https://api.exchangerate.host/latest
API_KEY=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
